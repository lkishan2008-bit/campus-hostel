# Flask
FLASK_SECRET_KEY=your-flask-secret-key
FLASK_DEBUG=True

# AWS Region
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

# AWS Credentials (configured in Elastic Beanstalk IAM role in production)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# AWS Cognito
COGNITO_USER_POOL_ID=your-user-pool-id
COGNITO_APP_CLIENT_ID=your-app-client-id
COGNITO_CLIENT_SECRET=your-cognito-client-secret
COGNITO_DOMAIN=

# DynamoDB Table Names
DYNAMODB_ORGANIZATIONS_TABLE=campus-hostel-organizations
DYNAMODB_MEMBERS_TABLE=campus-hostel-organization-members
DYNAMODB_COMPLAINTS_TABLE=campus-hostel-complaints
DYNAMODB_ANNOUNCEMENTS_TABLE=campus-hostel-announcements
DYNAMODB_MESS_MENU_TABLE=campus-hostel-mess-menu

# WhatsApp Notification Service (Cloud API - Optional)
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_API_VERSION=v19.0
WARDEN_PHONE_NUMBER=

# AI Complaint Intelligence Layer (Optional - heuristic fallback active by default)
AI_SERVICE_ENABLED=false
GEMINI_API_KEY=